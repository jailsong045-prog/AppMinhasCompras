<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <StackLayout Padding="20" Spacing="10">
        <Entry x:Name="txt_descricao" Placeholder="Descrição do produto" />
        <Entry x:Name="txt_quantidade" Keyboard="Numeric" Placeholder="Quantidade" />
        <Entry x:Name="txt_preco" Keyboard="Numeric" Placeholder="Preço unitário" />
    </StackLayout>
</ContentPage>